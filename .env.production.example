# Plantilla para un VPS inicial de 2 vCPU y 8 GB de RAM.
# Copie este archivo como .env.production en el servidor y reemplace los dos
# marcadores de secreto. No suba .env.production al repositorio.

EV3_WEB_APP_ENV=production
EV3_WEB_SECRET_KEY=REEMPLACE_POR_SECRETO_UNICO_DE_32_O_MAS_CARACTERES
EV3_WEB_OPERATIONS_TOKEN=REEMPLACE_POR_OTRO_SECRETO_UNICO_DE_32_O_MAS_CARACTERES
EV3_WEB_PUBLIC_HOST=simulador.ejemplo.edu.co
EV3_WEB_TLS_EMAIL=administracion@ejemplo.edu.co
# Mantenga 80/443 en el VPS. Solo para staging local use 8080/8443.
EV3_WEB_HTTP_PORT=80
EV3_WEB_HTTPS_PORT=443

# HTTPS termina en Nginx o Caddy; la aplicación recibe tráfico interno.
EV3_WEB_SESSION_COOKIE_SECURE=true
EV3_WEB_SESSION_COOKIE_PREFIX=__Host-ev3_
EV3_WEB_ENABLE_HSTS=true
EV3_WEB_TRUST_PROXY_HEADERS=true
EV3_WEB_OPERATIONS_ACCESS_POLICY=token

# Perfil inicial conservador para 2 vCPU / 8 GB.
EV3_WEB_MAX_ACTIVE_SESSIONS=20
EV3_WEB_MAX_RUNNING_SIMULATIONS=4
EV3_WEB_SCRIPT_MAX_RUNTIME_S=120
EV3_WEB_THREADS=8

# Rutas privadas dentro del tmpfs del contenedor.
EV3_WEB_WORKER_TEMP_ROOT=/tmp/ev3/workers
EV3_WEB_WORKER_TEMP_MAX_AGE_S=3600
EV3_WEB_FILE_MIRROR_ENABLED=true
EV3_WEB_FILE_MIRROR_DIR=/tmp/ev3/session-mirror

# Protección contra abuso y diagnóstico operativo.
EV3_WEB_RATE_LIMIT_ENABLED=true
EV3_WEB_RATE_LIMIT_SESSION_CREATE=12
EV3_WEB_RATE_LIMIT_SESSION_COMMAND=120

# No active Redis until a second Web replica is introduced.
EV3_WEB_SESSION_BACKEND=memory
EV3_WEB_REDIS_ENABLED=false
